# Hyperliquid network: testnet | mainnet
HL_NETWORK=testnet

# Master account address (required when using an API/agent wallet key)
# HL_ACCOUNT_ADDRESS=0x...

# Private key for signing (prefer API/agent wallet, not main wallet)
# HL_SECRET_KEY=0x...

# Skip websocket connections (recommended for CLI/scripts)
HL_SKIP_WS=true

# Local Postgres wallet registry (start with: docker compose up -d)
HL_DATABASE_URL=postgresql+psycopg://hlxfgen:hlxfgen@localhost:5440/hlxfgen

# Encrypt wallet private keys at rest in Postgres (run: hl db generate-key)
# HL_WALLET_ENCRYPTION_KEY=

# Optional: Telegram bot token (Phase 1)
# HL_TELEGRAM_BOT_TOKEN=
